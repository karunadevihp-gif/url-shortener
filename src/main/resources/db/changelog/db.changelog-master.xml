<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1-create-url-mapping-table" author="engineer">
        <createTable tableName="url_mapping">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="short_code" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="original_url" type="VARCHAR(2048)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="click_count" type="BIGINT" defaultValueNumeric="0"/>
            <column name="last_accessed_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="url_mapping" indexName="idx_short_code">
            <column name="short_code"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
